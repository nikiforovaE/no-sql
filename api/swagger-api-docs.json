          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Отзыв успешно создан",
            "headers": {
              "Set-Cookie": {
                "description": "Обновляет TTL сессии",
                "style": "simple"
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "id": "56e2c0b3a2b4c1a5e6f7f8b3"
                }
              }
