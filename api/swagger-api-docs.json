    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Проверяет работоспособность приложения. Если в запросе передана кука X-Session-Id, возвращает её обратно без обновления TTL в Redis.",
        "operationId": "health",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "cookie",
            "description": "Идентификатор сессии",
            "required": false,
            "schema": {
