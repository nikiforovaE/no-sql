    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Аутентификация пользователя",
        "description": "Проверяет credentials. При успехе привязывает сессию к пользователю и возвращает Cookie X-Session-Id.",
        "operationId": "login",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "cookie",
            "description": "ID сессии из Cookie",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "3f8a2c1d9e4b7f0a5c6d2e8b1a3f9c7d"
          }
        ],
        "requestBody": {
          "description": "Данные пользователя",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "j0hnd0e42",
                "password": "svp4_dvp4_str0ng_passw0rd"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Успешная аутентификация",
            "headers": {
              "Set-Cookie": {
                "description": "Устанавливает X-Session-Id куку",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Неверный логин или пароль",
            "headers": {
              "Set-Cookie": {
                "description": "Обновляет TTL существующей куки",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "message": "invalid credentials"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Получение мероприятия по ID",
        "operationId": "getEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID мероприятия",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "12e9c0b1a2b3c3d5e6f7a8b7"
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Session-Id",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Мероприятие найдено",
            "headers": {
              "Set-Cookie": {
                "description": "Возвращает куку БЕЗ обновления TTL",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "Мероприятие не найдено",
            "content": {
              "application/json": {
                "example": {
                  "message": "Not found"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Events"
        ],
        "summary": "Редактирование мероприятия",
        "description": "Доступно только организатору мероприятия. Позволяет изменить категорию, цену и город.",
        "operationId": "updateEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID мероприятия",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "12e9c0b1a2b3c3d5e6f7a8b7"
          },
          {
            "name": "X-Session-Id",
            "in": "cookie",
            "description": "ID сессии из Cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Поля для обновления",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventPatchRequest"
              },
              "example": {
                "category": "concert",
                "price": 1000,
                "city": "Москва"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Успешное обновление",
            "headers": {
              "Set-Cookie": {
                "description": "Обновляет TTL сессии",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Невалидные параметры",
            "content": {
              "application/json": {
                "example": {
                  "message": "invalid \"category\" field"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Мероприятие не найдено или вы не организатор",
            "content": {
              "application/json": {
                "example": {
                  "message": "Not found. Be sure that event exists and you are the organizer"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}/reviews/{review_id}": {
      "patch": {
        "tags": [
          "Events"
        ],
        "summary": "Изменить отзыв",
        "description": "Позволяет редактировать рейтинг и комментарий. Доступно только владельцу отзыва.",
        "operationId": "updateReview",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Session-Id",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Успешно обновлено",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Отзыв или мероприятие не найдено",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
