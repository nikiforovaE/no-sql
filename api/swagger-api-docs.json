            },
            "example": "a3f8a2c1d9e4b7f0a5c6d2e8b1a3f9c7d"
          }
        ],
        "responses": {
          "200": {
            "description": "Сервис доступен",
            "headers": {
              "Set-Cookie": {
                "description": "Возвращается только если X-Session-Id был передан в запросе. TTL НЕ обновляется.",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserRegistrationRequest": {
        "type": "object",
        "description": "Запрос на регистрацию нового пользователя",
        "properties": {
          "username": {
            "type": "string",
            "description": "Уникальный никнейм (логин)",
            "example": "j0hnd0e42"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Пароль",
            "example": "svp4_dvp4_str0ng_passw0rd"
          },
          "full_name": {
            "type": "string",
            "description": "Полное имя пользователя",
            "example": "Джон Доу"
          }
        },
        "required": [
          "full_name",
          "password",
          "username"
        ]
      },
      "EventCreateRequest": {
        "type": "object",
        "description": "Запрос на создание нового события",
        "properties": {
          "title": {
            "type": "string",
            "description": "Название события",
            "example": "Мой день рождения"
          },
          "description": {
            "type": "string",
            "description": "Описание события",
            "example": "Приглашаю вас отпраздновать мое 30-с-чем-то-летие"
          },
          "address": {
            "type": "string",
            "description": "Адрес проведения",
            "example": "г. Санкт-Петербург, ул. Пушкина, дом Колотушкина"
          },
          "started_at": {
            "type": "string",
            "description": "Дата и время начала в формате RFC3339",
            "example": "2026-04-01T12:00:00+03:00"
          },
          "finished_at": {
            "type": "string",
            "description": "Дата и время окончания в формате RFC3339",
            "example": "2026-04-01T23:00:00+03:00"
          }
        },
        "required": [
          "address",
          "finished_at",
          "started_at",
          "title"
        ]
      },
      "ReviewCreateRequest": {
        "type": "object",
        "description": "Запрос на оставление отзыва на мероприятие",
        "properties": {
          "comment": {
            "type": "string",
            "description": "Комментарий к отзыву (любые символы, максимум 300)",
            "example": "Великолепный спектакль! Идите, даже не думайте!",
            "maxLength": 300,
            "minLength": 0
          },
          "rating": {
            "type": "integer",
            "format": "int32",
            "description": "Оценка от 1 до 5 (только целые числа)",
            "example": 5,
            "maximum": 5,
            "minimum": 1
          }
        },
        "required": [
          "comment",
          "rating"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "description": "Данные для входа в систему",
        "properties": {
          "username": {
            "type": "string",
            "description": "Имя пользователя (username)",
            "example": "j0hnd0e42"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Пароль пользователя",
            "example": "svp4_dvp4_str0ng_passw0rd"
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "EventPatchRequest": {
        "type": "object",
        "description": "Запрос на частичное обновление мероприятия",
        "properties": {
          "category": {
            "type": "string",
            "description": "Категория мероприятия",
            "enum": [
              "meetup",
              "concert",
              "exhibition",
              "party",
              "other"
            ],
            "example": "concert"
          },
          "price": {
            "type": "integer",
            "format": "int32",
            "description": "Цена билета (целое число в абстрактных единицах)",
            "example": 1000,
            "minimum": 0
          },
          "city": {
            "type": "string",
            "description": "Наименование города. При пустом значении - удаляет город из локации мероприятия.",
            "example": "Москва"
          }
        }
      },
      "ReviewPatchRequest": {
        "type": "object",
        "description": "Запрос на частичное изменение отзыва",
        "properties": {
          "rating": {
            "type": "integer",
            "format": "int32",
            "description": "Новая оценка от 1 до 5. Только если нужно изменить.",
            "example": 3,
            "maximum": 5,
            "minimum": 1
          },
          "comment": {
            "type": "string",
            "description": "Новый комментарий (макс. 300 символов). Только если нужно изменить.",
            "example": "На самом деле, так себе спектакль..."
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "description": "Публичная информация о пользователе",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор пользователя (MongoDB ID)",
            "example": "65e9c0b1a2b3c4d5e6f7a8b9"
          },
          "full_name": {
            "type": "string",
            "description": "Полное имя пользователя",
            "example": "Иван Иванов"
          },
          "username": {
            "type": "string",
            "description": "Уникальное имя пользователя (логин)",
            "example": "ivan_ivanov"
          }
        }
      },
      "UserListResponse": {
        "type": "object",
        "description": "Объект ответа со списком пользователей (организаторов)",
        "properties": {
          "users": {
            "type": "array",
            "description": "Список найденных пользователей",
            "items": {
              "$ref": "#/components/schemas/UserInfo"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Количество пользователей в списке",
            "example": 1
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "Полная модель мероприятия",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор события (hex)",
            "example": "12e9c0b1a2b3c3d5e6f7a8b7"
          },
          "title": {
            "type": "string",
            "description": "Название события",
            "example": "Мой день рождения"
          },
          "description": {
            "type": "string",
            "description": "Подробное описание",
            "example": "Приглашаю вас отпраздновать мое 30-с-чем-то-летие"
          },
          "location": {
            "$ref": "#/components/schemas/Location",
            "description": "Данные о месте проведения"
          },
          "createdAt": {
            "type": "string",
            "description": "Дата создания записи (RFC3339)",
            "example": "2026-03-14T14:59:32+03:00"
          },
          "createdBy": {
            "type": "string",
            "description": "ID создателя (User hex ID)",
            "example": "65e9c0b1a2b3c4d5e6f7a8b9"
          },
          "startedAt": {
            "type": "string",
            "description": "Дата начала (RFC3339)",
            "example": "2026-04-01T12:00:00+03:00"
          },
          "finishedAt": {
            "type": "string",
            "description": "Дата окончания (RFC3339)",
            "example": "2026-04-01T23:00:00+03:00"
          },
          "category": {
            "type": "string",
            "description": "Категория",
            "enum": [
              "meetup",
              "concert",
              "exhibition",
              "party",
              "other"
            ],
            "example": "party"
          },
          "price": {
            "type": "integer",
            "format": "int32",
            "description": "Цена билета (0 для бесплатных)",
            "example": 0
          },
          "reactions": {
            "$ref": "#/components/schemas/ReactionResponse",
            "description": "Объект со счетчиками реакций (лайков и дизлайков)"
          },
          "reviews": {
            "$ref": "#/components/schemas/ReviewStatsResponse",
            "description": "Статистика отзывов"
          }
        }
      },
      "EventListResponse": {
        "type": "object",
        "description": "Объект ответа со списком мероприятий",
        "properties": {
          "events": {
            "type": "array",
            "description": "Список найденных событий",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Количество найденных событий в списке",
            "example": 1
          }
        }
      },
      "Location": {
        "type": "object",
        "description": "Географическое расположение события",
        "properties": {
          "address": {
            "type": "string",
            "description": "Полный адрес",
            "example": "г. Москва, ул. Пушкина, дом Колотушкина"
          },
          "city": {
            "type": "string",
            "description": "Город",
            "example": "Москва"
          }
        }
      },
      "ReactionResponse": {
        "type": "object",
        "description": "Счетчики реакций (лайков и дизлайков)",
        "properties": {
          "likes": {
            "type": "integer",
            "format": "int64",
            "description": "Количество лайков",
            "example": 24
          },
          "dislikes": {
            "type": "integer",
            "format": "int64",
            "description": "Количество дизлайков",
            "example": 3
          }
        }
      },
      "ReviewStatsResponse": {
        "type": "object",
        "description": "Усредненная информация об отзывах на мероприятие (данные из Redis)",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Общее количество всех отзывов на мероприятие (по его названию)",
            "example": 123
          },
          "rating": {
            "type": "number",
            "format": "double",
            "description": "Средний рейтинг всех отзывов, округлённый до одного знака после запятой",
            "example": 4.8
          }
        }
      },
      "ReviewListResponse": {
        "type": "object",
        "description": "Ответ со списком отзывов и общим количеством отзывов",
        "properties": {
          "reviews": {
            "type": "array",
            "description": "Список найденных отзывов",
            "items": {
              "$ref": "#/components/schemas/ReviewResponse"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Общее количество найденных отзывов",
            "example": 1
          }
        }
      },
      "ReviewResponse": {
        "type": "object",
        "description": "Данные конкретного отзыва",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID отзыва",
            "example": "56e2c0b3a2b4c1a5e6f7f8b3"
          },
          "event_id": {
            "type": "string",
            "description": "ID мероприятия в MongoDB",
            "example": "12e9c0b1a2b3c3d5e6f7a8b7"
          },
          "comment": {
            "type": "string",
            "description": "Комментарий пользователя",
            "example": "Великолепный спектакль! Идите, даже не думайте!"
          },
          "rating": {
            "type": "integer",
            "format": "int32",
            "description": "Оценка от 1 до 5",
            "example": 5
          },
          "created_at": {
            "type": "string",
            "description": "Дата создания (RFC3339)",
            "example": "2026-03-14T14:59:32+03:00"
          },
          "created_by": {
